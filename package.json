{
  "name": "starline",
  "private": true,
  "version": "0.0.0",
  "license": "MPL-2.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "chaos": "node scripts/chaos/run.mjs",
    "chaos:web": "node scripts/chaos/web.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "ci:gates": "pnpm typecheck && pnpm lint && pnpm test && pnpm --filter @starline/web build && pnpm check:bundle && pnpm check:perf && pnpm chaos && pnpm chaos:web && node scripts/check-no-network.mjs && node scripts/check-contrast.mjs && node scripts/verify-web.mjs && node scripts/verify-pwa.mjs && node scripts/check-a11y.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "fast-check": "^4.10.2",
    "fflate": "^0.8.3",
    "playwright": "1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
